{
  "name": "dunns-rental",
  "compatibility_date": "2025-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dunns-rental-db",
      "database_id": "fc7ff39d-0398-4b20-813e-a871a4d8e884"
    }
  ],
  "ai": {
    "binding": "AI"
  }
  // NOTE: The R2 bucket binding for document storage is intentionally omitted
  // until R2 is enabled on the Cloudflare account and the "dunns-rental-docs"
  // bucket is created. Re-add it then:
  //   "r2_buckets": [{ "binding": "DOCS", "bucket_name": "dunns-rental-docs" }]
  // The document endpoints return a friendly 503 while DOCS is unbound.
}
